# Supabase Configuration Template
# Copy this file to .env and fill in your Supabase project credentials.
# IMPORTANT: Only use the Anon / Publishable key for frontend access.
# NEVER include SUPABASE_SERVICE_ROLE_KEY or any confidential master keys!

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here
